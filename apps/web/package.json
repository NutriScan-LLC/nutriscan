{
  "name": "@nutriscan/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:workspace-deps": "npm run build --workspace @nutriscan/scanner && npm run build --workspace @nutriscan/scoring && npm run build --workspace @nutriscan/workflows",
    "predev": "npm run build:workspace-deps",
    "dev": "next dev",
    "prebuild": "npm run build:workspace-deps",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "npm run build:workspace-deps",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:workspace-deps",
    "test": "vitest run"
  },
  "dependencies": {
    "@nutriscan/scanner": "*",
    "@nutriscan/scoring": "*",
    "@nutriscan/workflows": "*",
    "@supabase/supabase-js": "^2.110.2",
    "framer-motion": "^12.43.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/w3c-web-serial": "^1.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
